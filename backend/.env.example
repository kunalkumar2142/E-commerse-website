# Copy to .env and fill in values before running docker compose.

# ---------- Database ----------
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---------- JWT ----------
# 512-bit base64 secret shared by user-authentication and api-gateway
JWT_SECRET=your-base64-jwt-secret-here

# ---------- Frontend (optional) ----------
# CORS origin allowed by the API gateway
FRONTEND_URL=http://localhost:5173
